# Secrets — never bake into the image
.env
*.env.local

# Python build artifacts
**/__pycache__
**/*.pyc
**/*.pyo
*.egg-info
.pytest_cache
.mypy_cache
venv
.venv
env

# Local SQLite (production uses Fly's volume)
data
*.db
*.db-journal
*.sqlite
*.sqlite3

# OS / IDE clutter
.DS_Store
Thumbs.db
.vscode
.idea
*.swp

# Git internals (Docker doesn't need them)
.git
.gitignore

# CI / Fly metadata that Docker doesn't need either
.github
fly.toml
