# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
# Your personal Discord user ID — receives link approval DMs.
# To get it: enable Developer Mode in Discord settings, right-click your name, "Copy User ID".
OWNER_DISCORD_ID=your_user_id_here

# Riot API
RIOT_API_KEY=RGAPI-your-personal-key-here
RIOT_REGION=na1
RIOT_REGIONAL_ROUTE=americas

# Bot config
ADMIN_ROLE_NAME=League Admin
DATABASE_URL=sqlite+aiosqlite:///./data/inhouse.db
TZ=America/New_York
